  "item": [
    {
      "name": "1. Crear encuentro",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 201 y crea un encuentro en BORRADOR con ID generado', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().estado).to.eql('BORRADOR'); pm.expect(pm.response.json().id).to.be.a('number'); pm.collectionVariables.set('encuentroId', String(pm.response.json().id)); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deporte\": \"Fútbol\",\n  \"fechaHora\": \"2099-05-10T18:00:00\",\n  \"cancha\": \"Cancha Postman\",\n  \"cupoMinimo\": 1,\n  \"cupoMaximo\": 2,\n  \"organizador\": \"Prueba Postman\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/encuentros"
      }
    },
    {
      "name": "2. Consultar encuentro",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Responde HTTP 200 y encuentra el ID creado', function () { pm.response.to.have.status(200); pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('encuentroId')); });"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/encuentros/{{encuentroId}}"
      }
    },
